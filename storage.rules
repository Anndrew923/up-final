rules_version = '2';

// Ladder display avatars — client uploads for signed-in owners; reads for signed-in viewers.
//
// WHY (genesis open access): Keep in lockstep with client `MONETIZATION_CONFIG.leaderboardPaywallEnabled`
// and Functions `LEADERBOARD_PAYWALL_ENABLED`. While genesis is open, owner write must not require
// Firestore Pro fields — otherwise `data:` avatar upload blocks the whole sync path on APK.
// Cutover back to Pro: re-wrap write/read with `hasValidPro` (see monetization.ts comment).
service firebase.storage {
  match /b/{bucket}/o {
    function isLadderAvatarOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidLadderAvatarUpload() {
      return request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /ladder-avatars/{uid}/avatar.jpg {
      // Genesis: any signed-in viewer can load ladder portraits.
      // Cutover to Pro: gate read/write with Firestore users/{uid} Pro fields
      // (subscriptionStatus in [pro,grace] + proExpiresAtMs).
      allow read: if request.auth != null;
      allow write: if isLadderAvatarOwner(uid) && isValidLadderAvatarUpload();
      allow delete: if isLadderAvatarOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
